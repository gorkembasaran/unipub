# Copy this file to .env.local for local development.
# Never commit real keys: .env and .env.* are git-ignored.

NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000

# Public demo: DEMO_MODE=true makes the API read-only.
# ENABLED_SOURCES limits source endpoints (empty = all):
# openalex,pubmed,trdizin,wos,scopus,scholar
DEMO_MODE=false
ENABLED_SOURCES=

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/unipub_local
MONGO_DB_NAME=unipub_local

# Auth (required in production)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Clarivate Web of Science
CLARIVATE_WOS_STARTER_API_KEY=
CLARIVATE_WOS_RESEARCHER_API_KEY=
CLARIVATE_TIMEOUT_MS=15000

# ScraperAPI (Scopus / PubMed scraping)
SCRAPERAPI_KEY=
SCRAPERAPI_TIMEOUT_MS=30000
PUBMED_SEARCH_MAX_PAGES=2
PUBMED_DETAIL_MAX_FETCHES=3
PUBMED_DETAIL_MIN_SCORE=12
SCOPUS_DETAIL_RENDER=true
SCOPUS_RENDER_COUNTRY_CODE=us
SCOPUS_RENDER_PREMIUM=false

# SerpApi (Google Scholar)
SERPAPI_KEY=
SERPAPI_KEY_2=
SERPAPI_ACTIVE_KEY=1
SERPAPI_TIMEOUT_MS=15000
SERPAPI_CACHE_TTL_MS=3600000

# OpenAlex (open data, default source for the public demo)
OPENALEX_MAILTO=
OPENALEX_API_KEY=
OPENALEX_TIMEOUT_MS=15000

# Crossref (polite pool contact)
CROSSREF_MAILTO=
