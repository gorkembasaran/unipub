# Copy to .env for `docker compose up`. Never commit the real .env.
# Every source except OpenAlex / Crossref / PubMed is optional and
# "bring your own key": leave it empty and that source stays unused.

# Public URLs (baked into the web bundle at build time)
PUBLIC_API_URL=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Auth (required: the API refuses to start in production without it)
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Open sources (used by the public demo)
OPENALEX_MAILTO=
OPENALEX_API_KEY=
CROSSREF_MAILTO=

# Bring-your-own-key sources (self-hosting only; check each provider's terms)
CLARIVATE_WOS_STARTER_API_KEY=
CLARIVATE_WOS_RESEARCHER_API_KEY=
SERPAPI_KEY=
SCRAPERAPI_KEY=
